<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <AssemblyName>VirtualPlc.CompatibilityHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/VirtualPlc/*.cs" Link="%(Filename)%(Extension)" />
    <Content Include="../../src/VirtualPlc/appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/VirtualPlc/wwwroot/**"
             Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
